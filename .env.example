# Blaulicht-Leitstand — Umgebungsvariablen (kopieren nach .env, Werte eintragen)

# --- Claude API (Fakten-Extraktion + Skript) ---
ANTHROPIC_API_KEY=

# --- Supabase (Projekt: ki_wn / Blaulicht) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # service_role Key (nur serverseitig!)
SUPABASE_ANON_KEY=

# --- Redis / Queue ---
REDIS_URL=redis://redis:6379/0

# --- Ingest ---
INGEST_TIMES=07:00,19:00         # Auto-Ingest 2x/Tag
INGEST_MIN_SCORE=40              # Default-Schwelle (in config änderbar)

# --- Guardrail Veröffentlichung ---
# Frische Taten NICHT sofort veröffentlichen (Ermittlungs-Peak/Unschuldsvermutung).
# Fall muss mind. so viele Stunden alt sein, sonst blockiert publish(). 0 = aus.
MIN_PUBLISH_AGE_HOURS=48

# --- Mail-Quelle (IMAP, Google-Alert-Mails) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_APP_PW=                     # App-Passwort, NICHT das normale Passwort
ALERT_SUBJECT_FILTER=zigaretten,geldautomat  # Alerts mit EINEM dieser Woerter im Betreff (kommagetrennt, leer = alle)
ALERT_TOPIC_KEYWORDS=zigaret,tabak,kippen,raucherwaren,geldautomat,bankautomat,ec-automat  # Nische Zigaretten- + Geldautomaten-Sprengung (leer = aus)
ALERT_MAX_AGE_DAYS=14            # nur Alert-Mails der letzten N Tage (0 = keine Grenze)

# --- TTS ---
# Umschaltbares Stimm-Backend: gemini (Standard) | edge (Fallback)
TTS_BACKEND=gemini
# Gemini TTS (google-genai) — Key aus Google AI Studio (Format AIza…)
GOOGLE_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Orus                # feste, bestimmte Stimme; Alt.: Charon, Iapetus, Enceladus …
# Regie-Anweisung an die Stimme (natuerlichsprachig, kein SSML):
TTS_STYLE="Sprich als tiefer True-Crime-Doku-Erzähler: düster und mit Spannung, aber in flüssigem, zügigem Tempo — sachlich, nicht reißerisch, keine Kunstpausen."
# edge-tts-Fallback (nur genutzt bei TTS_BACKEND=edge):
TTS_VOICE=de-DE-ConradNeural

# --- Leitstand-Login ---
LEITSTAND_PASSWORD=
SESSION_SECRET=                  # zufälliger Hex-String, z.B. python -c "import secrets;print(secrets.token_hex(32))"

# --- Zeitzone ---
TZ=Europe/Berlin

# --- Veröffentlichung (später) ---
# TIKTOK_TOKEN=
# YOUTUBE_TOKEN=
# INSTAGRAM_TOKEN=

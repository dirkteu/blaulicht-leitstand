# Blaulicht-Leitstand — Reverse-Proxy-Beispiel (Team 5 / Deploy)
# ================================================================
# Für den IONOS-VPS (217.154.171.136) mit Plesk (analog zu admin.videowachmann.de).
# Die App läuft NICHT in Plesks eigenem nginx, sondern als Docker-Container
# (docker-compose.yml, Service "api", Port 8000). Plesk-nginx reicht Requests
# für die Subdomain nur durch (Reverse Proxy auf 127.0.0.1:8000).
#
# Einbau bei Plesk: Domains -> leitstand.videowachmann.de -> Apache & nginx-
# Einstellungen -> "Zusätzliche nginx-Direktiven" -> Inhalt von
# ADDITIONAL_NGINX_BLOCK weiter unten einfügen. NICHT die ganze Datei 1:1
# übernehmen (kein server{}-Rahmen nötig, Plesk baut den selbst).
#
# Achtung (aus admin.videowachmann.de bekannt):
#   - "location ~ ^/" als REGEX verwenden, nicht "location /" oder "^~ /" —
#     kollidiert sonst mit Plesks eigenen internen locations.
#   - proxy_buffer_size etc. hochsetzen, falls Supabase-Auth/Session-Cookies
#     mal "upstream sent too big header" (502) auslösen (gestückelte
#     Set-Cookie-Header bei MFA/langen JWTs).
#   - Nach JEDER Änderung: `plesk sbin httpdmng --reconfigure-domain leitstand.videowachmann.de`
#
# ---------------------------------------------------------------------------
# ADDITIONAL_NGINX_BLOCK (in Plesk unter "Zusätzliche nginx-Direktiven" einfügen):
# ---------------------------------------------------------------------------

location ~ ^/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;

    # Standard-Proxy-Header
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket-Upgrade (falls später SSE/WS für Live-Updates im Leitstand
    # dazukommt; für reines HTMX-Polling/Swap schadet es nicht, wird nur bei
    # Upgrade-Header aktiv)
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Cookie/Header-Puffer hochsetzen (Supabase-Auth-Cookies können groß werden,
    # siehe 502-Vorfall bei admin.videowachmann.de)
    proxy_buffer_size          32k;
    proxy_buffers              8 32k;
    proxy_busy_buffers_size    64k;

    # Lange Renders/Downloads (Video-Streaming der signierten URLs läuft direkt
    # gegen Supabase, NICHT über diesen Proxy — trotzdem großzügige Timeouts
    # für langsame HTMX-Requests unter Last)
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}

# ---------------------------------------------------------------------------
# Für die $connection_upgrade-Variable braucht Plesk global (einmalig, meist
# schon vorhanden aus anderen Domains/Server-übergreifend) diese map — falls
# beim Reconfigure ein Fehler "$connection_upgrade not found" kommt, unter
# Tools & Einstellungen -> Apache & nginx -> "Zusätzliche nginx-Direktiven"
# auf Server-Ebene ergänzen:
# ---------------------------------------------------------------------------
#
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
#
# ---------------------------------------------------------------------------
# Reiner nginx (ohne Plesk) — vollständiger server{}-Block zum Vergleich:
# ---------------------------------------------------------------------------
#
# server {
#     listen 443 ssl http2;
#     server_name leitstand.videowachmann.de;
#
#     ssl_certificate     /etc/letsencrypt/live/leitstand.videowachmann.de/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/leitstand.videowachmann.de/privkey.pem;
#
#     location / {
#         proxy_pass http://127.0.0.1:8000;
#         proxy_http_version 1.1;
#         proxy_set_header Host              $host;
#         proxy_set_header X-Real-IP         $remote_addr;
#         proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header Upgrade    $http_upgrade;
#         proxy_set_header Connection $connection_upgrade;
#         proxy_buffer_size       32k;
#         proxy_buffers           8 32k;
#         proxy_busy_buffers_size 64k;
#     }
# }
#
# server {
#     listen 80;
#     server_name leitstand.videowachmann.de;
#     return 301 https://$host$request_uri;
# }
